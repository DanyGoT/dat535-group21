# One-time setup on the VM: copy to ~/.config/dat535/collector.env and chmod 600
# (NTFY_TOPIC is a secret). Not deployed by CI; after editing, restart the services yourself.
# Bronze workflows read this line and write their output next to it (/data/dat535/{dev,prod}).
DAT535_LANDING_DIR=/data/dat535/landing
MONITOR_STATUS_DIR=/home/ubuntu/dat535-data/status
RECEIVER_FEEDS=et,sx
RECEIVER_BIND=127.0.0.1
# Not 8080/8081: the Spark master and worker web UIs use those on the VM.
RECEIVER_PORT=8750
# Public https address that leads to this receiver (via your tunnel), without /siri/...
# Entur pushes data to <this>/siri/et and <this>/siri/sx.
# Leave unset until the tunnel exists: the receiver then listens but never subscribes.
#RECEIVER_PUBLIC_URL=https://siri.example.org
# dat535-tunnel.service: <user>@<host> of the public host running Caddy.
#TUNNEL_TARGET=dat535-tunnel@public.example.org
ET_CLIENT_NAME=uis-dat535group21-collector
# Statens vegvesen DATEX (datex.py). Confidential by NPRA's terms: never commit them.
# Unset: dat535-datex runs idle and the monitor shows it as IDLE, not as a failure.
# Test with: python3 ~/dat535-collector/datex.py --check
#DATEX_USERNAME=
#DATEX_PASSWORD=
# Default: all feeds (situation,traveltime,weather,traveltime-locations,weather-sites).
#DATEX_FEEDS=situation,traveltime,weather,traveltime-locations,weather-sites
STATUS_BIND=127.0.0.1
STATUS_PORT=8751
# Metrics for Prometheus; the port must match observability/prometheus.yml.
EXPORTER_BIND=127.0.0.1
EXPORTER_PORT=8752
MONITOR_MAX_PART_AGE_MIN=5
MONITOR_DISK_MAX_PCT=90
# Long random topic, e.g. dat535-g21-$(openssl rand -hex 12)
#NTFY_TOPIC=
# Public address of the status page; tapping a notification opens it. Optional.
#STATUS_PUBLIC_URL=https://status.example.org
